# ─────────────────────────────────────────────────────────────────────────────
# Jishora BACKEND — Production environment template (for Railway)
#
# HOW TO USE:
#   Do NOT commit a real .env. Instead, copy each KEY=VALUE below into your
#   Railway BACKEND service → "Variables" tab. Railway injects them at runtime.
#
#   The DB_* values come from your Railway MySQL plugin (see the guide). If you
#   use Railway's provided MYSQL* variables, you can reference them directly.
# ─────────────────────────────────────────────────────────────────────────────

# App
NODE_ENV=production
PORT=5000

# ── Database (paste from the Railway MySQL service → "Connect"/"Variables") ──
# Either set these explicitly:
DB_HOST=<railway-mysql-host>
DB_PORT=<railway-mysql-port>
DB_NAME=<railway-mysql-database>
DB_USER=<railway-mysql-user>
DB_PASSWORD=<railway-mysql-password>
# (On Railway you can often use the references ${{MySQL.MYSQLHOST}} etc.)

# ── Frontend origin — lock CORS to your deployed site ──
# Use your real frontend URL. With a custom domain:
FRONTEND_URL=https://jishora.com
# (If the frontend is on the *.up.railway.app URL, put that here instead.)

# ── JWT / session secrets — STRONG random values (already generated for you) ──
# Regenerate any time with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=7622863430a9fa43cc4d92bc93fcb6fbdb7b0fd30fd6a34d082a7e29a625150696f5867c68b98e33dbb8f7a853023481
JWT_REFRESH_SECRET=4bd151f9a58c6dc68ee9b8e8a2f654d950ea868299694104f75af4a3940f52df0ce8fd1716aefbd325b177ed21b3ad14
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=30d
SESSION_SECRET=60476bc5333c7d5d3b409a03d8137c15c6a884547e92afee856cc98aa98f7363

# ── Admin bootstrap ──
ADMIN_EMAIL=admin@jishora.com

# ── Security ──
BCRYPT_ROUNDS=10

# ── Email (optional; only if you enable email notifications) ──
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@jishora.com
